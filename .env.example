# Copy to .env.local. Never commit real keys. All AI calls run server-side.

# AI provider: "mock" (default, deterministic demo engine) or "gemini"
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Future: PostgreSQL connection for the production repository
# DATABASE_URL=postgres://user:password@localhost:5432/cekguard
